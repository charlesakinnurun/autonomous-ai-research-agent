# Copy to .env and fill in what you need. Never commit .env.
# Free-tier only in v0.1; every key below is optional for the scaffold.

# ---------- Runtime ----------
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# Single bearer-token auth stub. Replace before any non-local deployment.
API_AUTH_TOKEN=dev-local-token
# live = call providers; record = call and save cassettes; replay = CI only.
LLM_MODE=replay

# ---------- PostgreSQL (pgvector) ----------
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research

# ---------- Free-tier LLM providers (OpenAI-compatible) ----------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Local fallback; the key is a placeholder for the OpenAI-compatible endpoint.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Search ----------
SEARXNG_URL=http://localhost:8080
# Optional engine override; empty = SearXNG defaults.
SEARXNG_ENGINES=
# Descriptive UA with contact info; some sites reject generic clients.
SEARCH_USER_AGENT=autonomous-research-agent/0.1 (local research; contact: local)

# ---------- Local cache / embeddings ----------
CACHE_DIR=.cache/research-agent
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------- Config files (limits are never hardcoded in Python) ----------
PROVIDERS_CONFIG_PATH=config/providers.yaml
BUDGETS_CONFIG_PATH=config/budgets.yaml
RETRIEVAL_CONFIG_PATH=config/retrieval.yaml

# ---------- Hard per-run budgets (free tier: cost cap is $0) ----------
MAX_STEPS=40
MAX_TOOL_CALLS=25
MAX_TOTAL_TOKENS=100000
MAX_COST_USD=0.0
MAX_WALL_CLOCK_SECONDS=600
MAX_RESEARCH_LOOPS=2
MAX_REVISION_LOOPS=2

# ---------- Human approval policy ----------
APPROVAL_TTL_SECONDS=86400
APPROVAL_REQUIRED_MEMORY_WRITE=true
APPROVAL_REQUIRED_EXPORT=true
APPROVAL_REQUIRED_OVER_BUDGET=true

# ---------- Observability (optional OTLP exporter; no paid service) ----------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
